# Public anon credentials — safe for frontend builds (replace with your Supabase project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side seeding (scripts/seed_supabase.py) — never commit real keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Proprietary workers (local only — not in public repo)
# Riot dev portal key (optional)
RIOT_API_KEY=
OPENROUTER_API_KEY=
# Tavily web-search fallback for nuckyAI (server-only — never expose as VITE_).
# Set on Supabase: npx supabase secrets set TAVILY_API_KEY=...
TAVILY_API_KEY=
RECAP_LLM_MODEL=google/gemini-2.5-flash
RECAP_EMBEDDING_MODEL=openai/text-embedding-3-small
RECAP_REGENERATE=0
# Set on Supabase edge function secrets (not just .env / GitHub Actions):
#   npx supabase secrets set KALSHI_API_KEY=...
# Public Kalshi /markets + orderbook work without auth; key helps rate limits.
KALSHI_API_KEY=
# CitoAPI Pro — server-side only (never VITE_). Used by cito-live edge + nuckyAI agent-chat.
# Set on Supabase: npx supabase secrets set CITO_API_KEY=...
CITO_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID (price_xxx) for nuckyAI beta — NOT the Product ID (prod_xxx).
# Create in Stripe Dashboard → Product → Add price → copy Price ID.
# Used at frontend build time (checkout) — set locally in .env and in your host's build env (e.g. Vercel).
VITE_STRIPE_PRICE_ID=
