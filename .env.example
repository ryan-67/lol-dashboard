# Public anon credentials — safe for frontend builds (replace with your Supabase project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side seeding (scripts/seed_supabase.py) — never commit real keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Proprietary workers (local only — not in public repo)
# Riot dev portal key (optional)
RIOT_API_KEY=
OPENROUTER_API_KEY=
# Tavily web-search fallback for nuckyAI (server-only — never expose as VITE_).
# Set on Supabase: npx supabase secrets set TAVILY_API_KEY=...
TAVILY_API_KEY=
RECAP_LLM_MODEL=google/gemini-2.5-flash
RECAP_EMBEDDING_MODEL=openai/text-embedding-3-small
RECAP_REGENERATE=0
KALSHI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PRICE_ID=
